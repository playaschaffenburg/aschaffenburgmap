+    /// tile, with the materials a tile's splines get - the map editor's live preview of a
+    /// road being built. Taken away again with `remove_helper_object`.
+    pub fn add_helper_spline(&self, renderer: &Renderer, scene: &mut Scene, rel: &str, curve: &omsi_geometry::SplineCurve) -> Option<TileGpu> {
+        let st = self.spline_type(rel)?;
+        let curve = curve.with_sli(&st.def);
+        let origin = curve.start;
+        let mesh = build_spline_mesh(&st.def, &curve, false, origin);
+        if mesh.is_empty() {
+            return None;
+        }
+        let mut guard = self.gpu.lock();
+        let gpu = &mut *guard;
+        self.ensure_ground(renderer, scene, gpu);
+        let ground_mat = gpu.ground.as_ref()?.ground_mat;
+        let skey = Arc::as_ptr(&st) as usize;
+        if !gpu.splines.contains_key(&skey) {
+            let dirs = texture_dirs(&self.root, &st.dir);
+            let images: HashMap<PathBuf, Arc<TextureData>> = HashMap::new();
+            let mut sg = SplineGpu { _st: st.clone(), materials: Vec::new(), textures: Vec::new(), users: 0, terrain: Vec::new() };
+            for t in &st.def.textures {
+                let (tex, has_alpha) = match gpu.texture(renderer, scene, &t.file, &dirs, &images) {
+                    Some((id, path)) => {
+                        let a = gpu.has_alpha(&path);
+                        sg.textures.push(path);
+                        (Some(id), a)
+                    }
+                    None => (None, false),
+                };
+                let alpha = match (t.alpha, has_alpha) {
+                    (1, _) => AlphaMode::Test,
+                    (mode, true) if mode >= 2 => AlphaMode::Blend,
+                    _ => AlphaMode::Opaque,
+                };
+                let m = renderer.add_material_extra(scene, tex, alpha, [1.0; 4], false, None, None, None, None, [0.0; 3],
+                    MaterialExtra { no_z_write: alpha == AlphaMode::Blend, ..MaterialExtra::default() });
+                let m = gpu.material(renderer, scene, m);
+                sg.materials.push(m);
+            }
+            gpu.splines.insert(skey, sg);
+        }
+        let sg = gpu.splines.get_mut(&skey)?;
+        sg.users += 1;
+        let mats = if sg.materials.is_empty() { vec![ground_mat] } else { sg.materials.clone() };
+        let mut tg = TileGpu::default();
+        tg.spline_types.push(skey);
+        let id = gpu.add_mesh(renderer, scene, &mesh);
+        tg.meshes.push(id);
+        let si = renderer.add_surface_instance(scene, id, origin, Mat4::IDENTITY, mats);
+        if let Some(inst) = scene.instances.get_mut(si) {
+            inst.render_phase = RenderPhase::Spline;
+        }
+        let inst = gpu.instance(renderer, scene, si);
+        tg.instances.push(inst);
+        Some(tg)
+    }
+
     /// Take away an object `add_helper_object` put down.
