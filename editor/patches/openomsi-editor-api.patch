From 596e460251b086f739871a8134343aea3f22e5e0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 16:35:56 +0200
Subject: [PATCH 3/3] editor-api: Objekte bearbeiten und Kacheln schreiben
 ueber den Viewer

---
 crates/omsi-app/src/viewer.rs | 45 ++++++++++++++++++++++++++++++++++-
 1 file changed, 44 insertions(+), 1 deletion(-)

diff --git a/crates/omsi-app/src/viewer.rs b/crates/omsi-app/src/viewer.rs
index ebd8833..e926a15 100644
--- a/crates/omsi-app/src/viewer.rs
+++ b/crates/omsi-app/src/viewer.rs
@@ -10,7 +10,8 @@ use super::*;
 use hashbrown::HashSet;
 use std::time::Duration;
 
-pub use crate::scene::World;
+pub use crate::editor::{Action, Editor};
+pub use crate::scene::{EditObject, ObjectEdit, World};
 pub use omsi_render::{Camera, Lighting, RenderOptions, Renderer, Scene, SurfaceState};
 
 /// The graphics instance the game uses (the native API of the system).
@@ -187,4 +188,46 @@ impl Viewer {
     pub fn terrain_height(&self, x: f64, y: f64) -> Option<f64> {
         self.world.ground_terrain(x, y)
     }
+
+    // ------------------------------------------------------------ editing (the game's object editor)
+
+    /// Apply an editor action to the object `editor.selected` (or the copy being edited).
+    pub fn edit(&mut self, editor: &mut Editor, action: &Action) -> Option<String> {
+        editor.apply(&self.world, &self.renderer, &mut self.scene, action)
+    }
+
+    /// Put the edited object with its foot at `ground`.
+    pub fn drag(&mut self, editor: &mut Editor, ground: DVec3) -> Option<String> {
+        editor.drag_to(&self.world, &self.renderer, &mut self.scene, ground)
+    }
+
+    /// The edits so far of object `id`.
+    pub fn object_edit(&self, id: i64) -> ObjectEdit {
+        self.world.object_edits.lock().get(&id).copied().unwrap_or_default()
+    }
+
+    /// Objects of the loaded tiles: (id, where it stands now (edits included), heading in
+    /// degrees, its .sco), deleted ones left out.
+    pub fn objects(&self) -> Vec<(i64, DVec3, f64, PathBuf)> {
+        let objs = self.world.edit_objects.lock();
+        let edits = self.world.object_edits.lock();
+        objs.iter()
+            .filter_map(|(id, o)| {
+                let e = edits.get(id).copied().unwrap_or_default();
+                if e.deleted {
+                    return None;
+                }
+                let f = o.xf.transform_vector3(Vec3::Y);
+                let h = (f.x as f64).atan2(f.y as f64).to_degrees() + e.turned;
+                Some((*id, o.pos + e.moved, h, o.sco.clone()))
+            })
+            .collect()
+    }
+
+    /// Write the tiles the editor changed into `staging` (never into the installation):
+    /// `staging/<map folder>/tile_x_y.map` (+ `.terrain`). `map_rel` is the map's
+    /// global.cfg relative to the OMSI folder (maps/<name>/global.cfg).
+    pub fn save_edits(&self, editor: &Editor, map_rel: &str, staging: &Path) -> std::result::Result<Vec<PathBuf>, String> {
+        editor.save(&self.world, map_rel, staging, &self.root)
+    }
 }
-- 
