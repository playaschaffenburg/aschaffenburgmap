+    /// The lanes of spline type `rel`: (kind 0 road / 1 footway / 2 rail, x across (right
+    /// positive), height, width, direction 0 along / 1 against / 2 both), and the outer
+    /// half widths (left, right) of its drawn profile.
+    pub fn spline_lanes(&self, rel: &str) -> Option<(Vec<(u8, f32, f32, f32, u8)>, (f32, f32))> {
+        let st = self.world.spline_type(rel)?;
+        let lanes = st.def.paths.iter().map(|p| (p.kind as u8, p.start[0], p.start[1], p.width, p.direction as u8)).collect();
+        let (lo, hi) = st.def.profiles.iter().flat_map(|p| p.points.iter().map(|q| q.x)).fold((0.0f32, 0.0f32), |(a, b), x| (a.min(x), b.max(x)));
+        Some((lanes, (-lo, hi)))
+    }
