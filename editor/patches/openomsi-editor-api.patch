+    pub fn add_helper_spline(&self, renderer: &Renderer, scene: &mut Scene, rel: &str, curve: &omsi_geometry::SplineCurve) -> Option<TileGpu> {
+        let st = self.spline_type(rel)?;
+        let curve = curve.with_sli(&st.def);
+        let origin = curve.start;
+        let mesh = build_spline_mesh(&st.def, &curve, false, origin);
+        if mesh.is_empty() {
+            return None;
+        }
+        let mut guard = self.gpu.lock();
+        let gpu = &mut *guard;
+        self.ensure_ground(renderer, scene, gpu);
+        let ground_mat = gpu.ground.as_ref()?.ground_mat;
+        let skey = Arc::as_ptr(&st) as usize;
+        if !gpu.splines.contains_key(&skey) {
+            let dirs = texture_dirs(&self.root, &st.dir);
+            let images: HashMap<PathBuf, Arc<TextureData>> = HashMap::new();
+            let mut sg = SplineGpu { _st: st.clone(), materials: Vec::new(), textures: Vec::new(), users: 0, terrain: Vec::new() };
+            for t in &st.def.textures {
