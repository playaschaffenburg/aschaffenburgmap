+        tg.spline_types.push(skey);
+        let id = gpu.add_mesh(renderer, scene, &mesh);
+        tg.meshes.push(id);
+        let si = renderer.add_surface_instance(scene, id, origin, Mat4::IDENTITY, mats);
+        if let Some(inst) = scene.instances.get_mut(si) {
