+    /// A square picture of a straight piece of road of spline type `rel` (RGBA), seen from
+    /// the front left and above, against the sky: put far outside the map for the picture.
+    pub fn preview_spline_image(&mut self, rel: &str, size: u32) -> Option<Vec<u8>> {
+        let (_, (links, rechts)) = self.spline_lanes(rel)?;
+        let breite = (links + rechts).max(2.0) as f64;
+        let laenge = (breite * 2.2).clamp(12.0, 60.0);
+        let at = DVec3::new(-2.0e5, 2.0e5, 0.0);
+        let curve = omsi_geometry::SplineCurve {
+            start: at, heading_deg: 0.0, length: laenge, radius: 0.0, grad_start: 0.0, grad_end: 0.0, delta_h: None,
+            cant_start: 0.0, cant_end: 0.0, skew_start: 0.0, skew_end: 0.0, tex_offset: 0.0, seed: 1, half_cant_width: 0.0,
+        };
+        let tg = self.add_spline(rel, &curve)?;
+        let mitte = at + DVec3::new((rechts - links) as f64 * 0.5, laenge * 0.5, 0.0);
+        let r = ((laenge * 0.5).powi(2) + (breite * 0.5).powi(2)).sqrt();
+        let fov: f32 = 35.0;
+        let dist = r / (fov as f64 / 2.0).to_radians().sin() * 0.8;
+        let mut cam = Camera { position: DVec3::ZERO, yaw: 25.0, pitch: -38.0, roll: 0.0, fov_deg: fov, near: (dist - r * 1.5).max(0.05) as f32, far: (dist + r * 3.0 + 20.0) as f32 };
+        cam.position = mitte - cam.forward().as_dvec3() * dist;
+        let img = self.render_image(size, size, &cam).ok();
+        self.remove_object(tg);
+        img
+    }
