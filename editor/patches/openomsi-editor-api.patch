From 237ec37d6957dab1787c4d67d58d7803945fd3f5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 17:10:18 +0200
Subject: [PATCH 05/16] editor-api: Objektausmasse und Vorschaubilder

---
 crates/omsi-app/src/viewer.rs | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/crates/omsi-app/src/viewer.rs b/crates/omsi-app/src/viewer.rs
index 61f58bb..e92c3f2 100644
--- a/crates/omsi-app/src/viewer.rs
+++ b/crates/omsi-app/src/viewer.rs
@@ -255,4 +255,38 @@ impl Viewer {
     pub fn tile_file(&self, tx: i32, ty: i32) -> Option<PathBuf> {
         self.world.tile_source(tx, ty)
     }
+
+    // ------------------------------------------------------------ previews (catalog thumbnails)
+
+    /// Bounds (min, max) of object type `rel` in its own frame (x right, y forward, z up).
+    pub fn object_bounds(&self, rel: &str) -> Option<(Vec3, Vec3)> {
+        let ot = self.world.object_type(rel)?;
+        let mut lo = Vec3::splat(f32::INFINITY);
+        let mut hi = Vec3::splat(f32::NEG_INFINITY);
+        for (m, _, _) in &ot.meshes {
+            for p in &m.positions {
+                lo = lo.min(*p);
+                hi = hi.max(*p);
+            }
+        }
+        (lo.is_finite() && hi.is_finite()).then_some((lo, hi))
+    }
+
+    /// A square picture of object type `rel` alone (RGBA, `size` x `size`), seen from the
+    /// front left and a little above, against the sky: it is put far outside the map for
+    /// the picture and taken away again.
+    pub fn preview_image(&mut self, rel: &str, size: u32) -> Option<Vec<u8>> {
+        let (lo, hi) = self.object_bounds(rel)?;
+        let at = DVec3::new(2.0e5, 2.0e5, 0.0);
+        let tg = self.add_object(rel, at, 0.0)?;
+        let centre = at + ((lo + hi) * 0.5).as_dvec3();
+        let r = ((hi - lo).length() * 0.5).max(0.25) as f64;
+        let fov: f32 = 35.0;
+        let dist = r / (fov as f64 / 2.0).to_radians().sin() * 1.02;
+        let mut cam = Camera { position: DVec3::ZERO, yaw: 215.0, pitch: -20.0, roll: 0.0, fov_deg: fov, near: (dist - r * 1.5).max(0.05) as f32, far: (dist + r * 3.0 + 20.0) as f32 };
+        cam.position = centre - cam.forward().as_dvec3() * dist;
+        let img = self.render_image(size, size, &cam).ok();
+        self.remove_object(tg);
+        img
+    }
 }
