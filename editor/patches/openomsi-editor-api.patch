diff --git a/crates/omsi-app/src/viewer.rs b/crates/omsi-app/src/viewer.rs
new file mode 100644
index 0000000..f57565c
--- /dev/null
+++ b/crates/omsi-app/src/viewer.rs
@@ -0,0 +1,146 @@
+//! editor-api: a small public interface for embedding the map view in another program (the
+//! omsi-editor of the aschaffenburgmap project). Everything here uses the game's own
+//! loading and drawing - the picture is the game's - but without vehicles, traffic,
+//! timetable or sound: a map, its tiles around a point, a camera and a fixed time of day.
+//!
+//! This file and the line `pub mod viewer;` in lib.rs are the whole change on the
+//! `editor-api` branch (plus loading OpenXR at run time instead of linking it).
+
+use super::*;
+use hashbrown::HashSet;
+
+pub use crate::scene::World;
+pub use omsi_render::{Camera, Lighting, RenderOptions, Renderer, Scene, SurfaceState};
+
+/// The graphics instance the game uses (the native API of the system).
+pub fn instance() -> wgpu::Instance {
+    crate::startup::graphics_instance()
+}
+
+/// A loaded map with its renderer and scene.
+pub struct Viewer {
+    pub renderer: Renderer,
+    pub scene: Scene,
+    pub world: World,
+    pub root: PathBuf,
+    /// Hours since midnight of the fixed daylight (12 = noon).
+    pub hour: f64,
+    loaded: HashSet<(i32, i32)>,
+}
+
+impl Viewer {
+    /// Open `global_cfg` (path to a map's global.cfg) of the OMSI installation `root`.
+    /// `surface` picks an adapter and format that can show it (None: offscreen, sRGB RGBA).
+    pub fn open(
+        instance: &wgpu::Instance,
+        surface: Option<&wgpu::Surface<'_>>,
+        root: &Path,
+        global_cfg: &Path,
+    ) -> Result<(Viewer, Camera)> {
+        let settings = settings::Settings::load();
+        let format = if surface.is_none() { Some(wgpu::TextureFormat::Rgba8UnormSrgb) } else { None };
+        let mut renderer = pollster::block_on(Renderer::new_with(instance, surface, format, settings.render_options()))?;
+        crate::lights::load_smoke_texture(&mut renderer, root);
+        crate::lights::set_corona_root(root);
+        let scene = renderer.new_scene();
+        omsi_texture::set_season_folder(None);
+        let clock = Self::clock_at(12.0);
+        let world = World::open(root, global_cfg, clock.date_code())?;
+        let camera = crate::camera_util::default_camera(&world);
+        Ok((
+            Viewer { renderer, scene, world, root: root.to_path_buf(), hour: 12.0, loaded: HashSet::new() },
+            camera,
+        ))
+    }
+
+    fn clock_at(hour: f64) -> omsi_sim::SimClock {
+        omsi_sim::SimClock { year: 2026, day_of_year: 172, time: hour * 3600.0, timegap: 0.0, paused: true, run_time: 0.0 }
+    }
+
+    /// Tile of a world point (x east, y north).
+    pub fn tile_of(p: DVec3) -> (i32, i32) {
+        ((p.x / omsi_map::tile_size()).floor() as i32, (p.y / omsi_map::tile_size()).floor() as i32)
+    }
+
+    /// The map's tiles (x, y).
+    pub fn map_tiles(&self) -> Vec<(i32, i32)> {
+        self.world.global.tiles.iter().map(|t| (t.x, t.y)).collect()
+    }
+
+    /// Load the tiles within `radius` tiles of `center` that are not loaded yet; tiles
+    /// further than `radius + 2` are unloaded. Returns how many were loaded.
+    pub fn tiles_around(&mut self, center: DVec3, radius: i32) -> Result<usize> {
+        let (cx, cy) = Self::tile_of(center);
+        let want: Vec<_> = self
+            .world
+            .select_tiles(Some((cx, cy)), Some(radius))
+            .into_iter()
+            .filter(|t| !self.loaded.contains(&(t.0, t.1)))
+            .collect();
+        let far: Vec<(i32, i32)> = self
+            .loaded
+            .iter()
+            .copied()
+            .filter(|&(x, y)| (x - cx).abs() > radius + 2 || (y - cy).abs() > radius + 2)
+            .collect();
+        for k in &far {
+            self.world.unload_tile(&self.renderer, &mut self.scene, *k, None);
+            self.loaded.remove(k);
+        }
+        if !far.is_empty() {
+            self.world.trim_object_types();
+            self.world.refresh_tile_lists();
+        }
+        if want.is_empty() {
+            return Ok(0);
+        }
+        self.world.build_scene(&self.renderer, &mut self.scene, &want)?;
+        for t in &want {
+            self.loaded.insert((t.0, t.1));
+        }
+        Ok(want.len())
+    }
+
+    /// Unload everything (before the map's files change, e.g. after the editor saved).
+    pub fn unload_all(&mut self) {
+        for k in self.loaded.drain().collect::<Vec<_>>() {
+            self.world.unload_tile(&self.renderer, &mut self.scene, k, None);
+        }
+        self.world.trim_object_types();
+        self.world.refresh_tile_lists();
+    }
+
+    pub fn loaded_tiles(&self) -> usize {
+        self.loaded.len()
+    }
+
+    /// The renderer's lighting for the fixed time of day.
+    pub fn lighting(&self) -> Lighting {
+        let d = omsi_sim::Daylight::compute(&Self::clock_at(self.hour), None);
+        crate::lights::lighting_from(&d, 4000.0)
+    }
+
+    /// Draw a frame into `target` (a texture view of the renderer's format).
+    pub fn render(&mut self, target: &wgpu::TextureView, width: u32, height: u32, camera: &Camera) {
+        self.renderer.prepare(&mut self.scene);
+        let lighting = self.lighting();
+        self.renderer.render(&mut self.scene, target, width, height, camera, &lighting);
+    }
+
+    /// A frame as RGBA pixels (offscreen).
+    pub fn render_image(&mut self, width: u32, height: u32, camera: &Camera) -> Result<Vec<u8>> {
+        self.renderer.prepare(&mut self.scene);
+        let lighting = self.lighting();
+        self.renderer.render_to_image(&mut self.scene, width, height, camera, &lighting)
+    }
+
+    /// Height of what stands at (x, y): roads, objects to stand on, else the ground.
+    pub fn ground_height(&self, x: f64, y: f64) -> Option<f64> {
+        self.world.ground_height(x, y)
+    }
+
+    /// Height of the ground alone at (x, y).
+    pub fn terrain_height(&self, x: f64, y: f64) -> Option<f64> {
+        self.world.ground_terrain(x, y)
+    }
+}
-- 
2.55.0.windows.5


From cc51e3c693d2333dc4ee49c47f6e37c20ab516e8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 16:22:56 +0200
Subject: [PATCH 2/3] editor-api: Hintergrund-Streaming und Kartenwechsel mit
 demselben Renderer

---
 crates/omsi-app/src/viewer.rs | 50 ++++++++++++++++++++++++++++++++---
 1 file changed, 47 insertions(+), 3 deletions(-)

diff --git a/crates/omsi-app/src/viewer.rs b/crates/omsi-app/src/viewer.rs
index f57565c..ebd8833 100644
--- a/crates/omsi-app/src/viewer.rs
+++ b/crates/omsi-app/src/viewer.rs
@@ -8,6 +8,7 @@
 
 use super::*;
 use hashbrown::HashSet;
+use std::time::Duration;
 
 pub use crate::scene::World;
 pub use omsi_render::{Camera, Lighting, RenderOptions, Renderer, Scene, SurfaceState};
@@ -21,11 +22,12 @@ pub fn instance() -> wgpu::Instance {
 pub struct Viewer {
     pub renderer: Renderer,
     pub scene: Scene,
-    pub world: World,
+    pub world: Arc<World>,
     pub root: PathBuf,
     /// Hours since midnight of the fixed daylight (12 = noon).
     pub hour: f64,
     loaded: HashSet<(i32, i32)>,
+    streamer: Option<crate::tiles::Streamer>,
 }
 
 impl Viewer {
@@ -46,13 +48,30 @@ impl Viewer {
         omsi_texture::set_season_folder(None);
         let clock = Self::clock_at(12.0);
         let world = World::open(root, global_cfg, clock.date_code())?;
+        world.set_fast_texture_loads(true);
+        world.set_texture_budget(crate::memory::texture_budget(&settings));
         let camera = crate::camera_util::default_camera(&world);
         Ok((
-            Viewer { renderer, scene, world, root: root.to_path_buf(), hour: 12.0, loaded: HashSet::new() },
+            Viewer { renderer, scene, world: Arc::new(world), root: root.to_path_buf(), hour: 12.0, loaded: HashSet::new(),
+                     streamer: None },
             camera,
         ))
     }
 
+    /// Open another map with the same renderer (its pipelines are compiled once per session,
+    /// several seconds): the old world, scene and streaming go, the new world comes.
+    pub fn open_map(&mut self, global_cfg: &Path) -> Result<Camera> {
+        self.streamer = None;
+        self.loaded.clear();
+        let world = World::open(&self.root, global_cfg, Self::clock_at(self.hour).date_code())?;
+        world.set_fast_texture_loads(true);
+        world.set_texture_budget(crate::memory::texture_budget(&settings::Settings::load()));
+        let camera = crate::camera_util::default_camera(&world);
+        self.scene = self.renderer.new_scene();
+        self.world = Arc::new(world);
+        Ok(camera)
+    }
+
     fn clock_at(hour: f64) -> omsi_sim::SimClock {
         omsi_sim::SimClock { year: 2026, day_of_year: 172, time: hour * 3600.0, timegap: 0.0, paused: true, run_time: 0.0 }
     }
@@ -111,7 +130,32 @@ impl Viewer {
     }
 
     pub fn loaded_tiles(&self) -> usize {
-        self.loaded.len()
+        self.world.loaded_tiles().len()
+    }
+
+    /// Stream the tiles within `radius` metres of `center` in the background, as the game's
+    /// window does: read and tessellated on a worker thread, nearest first, uploaded for
+    /// about `budget` each call, far tiles unloaded. Call once a frame. Returns true when
+    /// the loaded tiles changed.
+    pub fn stream(&mut self, center: DVec3, radius: f64, budget: Duration) -> bool {
+        let centers = [center];
+        let s = self
+            .streamer
+            .get_or_insert_with(|| crate::tiles::Streamer::new(self.world.clone(), &centers, radius, radius.min(700.0)));
+        s.load_radius = radius;
+        s.unload_radius = radius + omsi_map::tile_size() * 1.5;
+        self.world.apply_texture_upgrades(&self.renderer, &mut self.scene, Some(Instant::now() + Duration::from_millis(2)));
+        self.world.update_texture_budget(&self.renderer, &mut self.scene, &centers, false);
+        let changed = s.update(&self.renderer, &mut self.scene, &centers, budget, None);
+        if changed {
+            self.world.update_texture_budget(&self.renderer, &mut self.scene, &centers, true);
+        }
+        changed
+    }
+
+    /// (uploaded, total) of the first area while it is still loading.
+    pub fn first_area_progress(&self) -> Option<(usize, usize)> {
+        self.streamer.as_ref().and_then(|s| s.initial_progress())
     }
 
     /// The renderer's lighting for the fixed time of day.
-- 
