+    /// its street lanes leads on there or comes in from somewhere? None when the spline has
+    /// no street lanes (or its tile is not loaded).
+    pub fn spline_end_free(&self, id: i64, at_end: bool) -> Option<bool> {
+        let mut any = false;
+        let mut free = true;
+        for (i, l) in self.lanes.lanes.iter().enumerate() {
+            if l.kind != omsi_sim::traffic::LaneKind::Street || l.key.map(|k| k.id) != Some(id) {
