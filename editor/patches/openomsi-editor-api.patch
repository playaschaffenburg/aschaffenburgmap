+    /// Draw one spline segment of type `rel` (.sli, relative to the OMSI folder) along
+    /// `curve`, outside any tile. Taken away with `remove_object`.
+    pub fn add_spline(&mut self, rel: &str, curve: &omsi_geometry::SplineCurve) -> Option<TileGpu> {
