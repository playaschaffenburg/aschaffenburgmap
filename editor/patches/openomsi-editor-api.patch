+    /// Take the lanes the tiles loaded since the last call brought into `lanes` (a tile
+    /// loaded again brings nothing new: its lanes are there already).
+    fn collect_lanes(&mut self) {
+        let new = std::mem::take(&mut *self.world.lanes.lock());
